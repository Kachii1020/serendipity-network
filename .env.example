# Local Phase 0 origins. Production values must be fixed HTTPS origins with no wildcard.
NEXT_PUBLIC_HUB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_PROVIDER_ORIGINS=http://localhost:3101,http://localhost:3102,http://localhost:3103
NEXT_PUBLIC_PROVIDER_SLUG=kiln
NEXT_PUBLIC_WEBMCP_EXPOSED_TO=http://localhost:3100

# Server-side Provider identity. Must match the deployed Provider origin.
PROVIDER_SLUG=kiln

# T019 selected the evidence-backed direct-provider fallback.
WEBMCP_COMPOSITION_MODE=direct
WEBMCP_EXECUTION_ENCODING=json-string

# Optional fixed staging origins populated by T016.
STAGING_HUB_ORIGIN=
STAGING_KILN_ORIGIN=
STAGING_NORI_ORIGIN=
STAGING_LOOP_ORIGIN=

# Vercel project names are identifiers, not credentials.
VERCEL_HUB_PROJECT=serendipity-phase0-hub
VERCEL_KILN_PROJECT=serendipity-phase0-kiln
VERCEL_NORI_PROJECT=serendipity-phase0-nori
VERCEL_LOOP_PROJECT=serendipity-loop

# Server-only database and signing configuration. Never use NEXT_PUBLIC_ prefixes.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
HOLD_TOKEN_SECRET=
PROVIDER_ACCESS_TOKEN_SECRET=
HUB_INTERSERVICE_SECRET=
BUNDLE_ENCRYPTION_KEY=
DEMO_OPERATOR_SECRET=
DEMO_MODE=false
